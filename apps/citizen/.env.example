EXPO_PUBLIC_API_URL=http://localhost:3000

# Android emulator → host machine API
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Demo citizen seeded by `pnpm db:seed` (dev pickup flow only)
EXPO_PUBLIC_DEV_CITIZEN_ID=00000000-0000-4000-8000-000000000001
