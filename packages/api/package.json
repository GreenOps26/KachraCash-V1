{
	"name": "@kachracash/api",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./services/*": "./src/services/*.ts"
	},
	"scripts": {
		"build": "tsc --noEmit",
		"typecheck": "tsc --noEmit",
		"dev": "tsx watch src/server.ts",
		"start": "tsx src/server.ts",
		"test": "vitest run",
		"test:unit": "vitest run src/__tests__/unit",
		"test:integration": "vitest run src/__tests__/integration"
	},
	"dependencies": {
		"@fastify/cors": "^11.0.1",
		"@kachracash/db": "workspace:*",
		"@kachracash/types": "workspace:*",
		"bcryptjs": "^3.0.2",
		"fastify": "^5.6.0",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@types/node": "^24",
		"@types/bcryptjs": "^2.4.6",
		"tsx": "^4.20.5",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	}
}
