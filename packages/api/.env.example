PORT=3000
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# --- UPI payout gateway (keys optional until go-live) ---
PAYOUT_GATEWAY_PROVIDER=stub
PAYOUT_GATEWAY_MODE=stub
PAYOUT_STUB_AUTO_CONFIRM=true

# Pilot dev OTP for citizen/partner E2E (fixed 4829 when true)
PICKUP_DEV_OTP=true
COLLECTOR_DEV_AUTH=true
JWT_SECRET=change-me-in-production

# Cashfree Payouts (sandbox)
# CASHFREE_PAYOUT_CLIENT_ID=
# CASHFREE_PAYOUT_CLIENT_SECRET=
# CASHFREE_PAYOUT_API_BASE=https://sandbox.cashfree.com/payout
