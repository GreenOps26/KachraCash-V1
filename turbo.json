{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "dist/**", ".svelte-kit/**", "build/**"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"lint": {
			"outputs": []
		},
		"check": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["build"],
			"outputs": ["coverage/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"db:generate": {
			"cache": false
		},
		"test:unit": {
			"outputs": []
		},
		"test:integration": {
			"outputs": []
		}
	}
}
